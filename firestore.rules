rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function signedIn() { return request.auth != null; }
    // "known" = signed in AND has an admin-created profile doc. Firebase Auth's email/password
    // provider technically allows anyone with the public API key to self-register an account
    // OUTSIDE this app (the app itself never exposes a sign-up form) — signedIn() alone would let
    // such an account read data. Requiring a users/{uid} profile closes that gap: only accounts
    // created via the adminCreateUser Cloud Function ever get one.
    function isKnownUser() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    /* PERMISSIONS v2 — custom claims carry COMPACT on/off flags under token.p:
         bv bc be bp ba bd   = bills: view / create / edit / payments / archive / delete
         rv rr rp            = recycle bin: view / restore / purge (delete forever)
         rep av pd sm        = reports view / activity view / products delete / settings manage
       days + user-scope fine-graining is enforced by the app + Cloud Functions (claims
       have a 1000-byte limit, and rules can't express "last N days of another user's
       bills" efficiently) — these flags are the hard on/off backstop.
       LEGACY FALLBACK: purane tokens me flags token.perms.<flat-key> ke andar the — jab tak
       har user ke claims naye Cloud Functions se dobara set nahi hote, dono shapes qabool
       hain taake naya rules-deploy purane logged-in users ko na tore. */
    function perm(p, lg) {
      return signedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.p != null && request.auth.token.p[p] == true) ||
        (request.auth.token.perms != null && request.auth.token.perms[lg] == true)
      );
    }

    /* ---------- users: read by any KNOWN user; writes only via Cloud Functions (Admin SDK bypasses rules) ---------- */
    match /users/{uid} {
      allow read: if isKnownUser();
      allow write: if false;   // all user admin goes through callable functions
    }

    /* ---------- app: settings + counter + access (kill switch) ---------- */
    match /app/access {
      // must be readable by EVERYONE, even signed-out — the app checks this before showing login.
      allow read: if true;
      // the app may create the default (unblocked) doc once if it doesn't exist yet; after that,
      // only an operator editing Firestore directly (console / Admin SDK, which bypasses rules)
      // can ever change it — no client can flip the switch or edit the message once it exists.
      allow create: if request.resource.data.isBlocked == 0
                    && request.resource.data.keys().hasOnly(['isBlocked','title','message']);
      allow update, delete: if false;
    }
    match /app/{doc} {
      allow read: if isKnownUser();
      // counter is written transactionally whenever a bill is created. noteTemplates (printed-Comment
      // + Internal-note markdown templates) are shop-wide and MUST be editable by anyone who can
      // create a bill — NOT gated behind settings — so they share the bills_create backstop with
      // counter. printPresets (named print-appearance bundles) are readable by everyone (so the print
      // dialog can list & apply them) but only WRITTEN from the settings-gated Template page, so they
      // fall to the settings branch below. Everything else under /app (e.g. settings) needs settings.
      // 'access' (the kill switch) is explicitly excluded here so NO client write path exists for it —
      // only the restricted create + console/Admin SDK edits in the /app/access block above can touch it.
      allow write: if doc != 'access'
                   && ((doc == 'counter' || doc == 'noteTemplates') ? perm('bc', 'bills_create') : perm('sm', 'settings'));
    }

    /* ---------- bills ---------- */
    match /bills/{id} {
      // read stays profile-gated: "view" days/user-scope filtering happens in the app
      // (a self-scoped user still needs to read own docs; Firestore can't filter that here).
      allow read:   if isKnownUser();
      allow create: if perm('bc', 'bills_create');
      // edits, archive flips, payments, soft-delete land as updates; restore (from bin) too
      allow update: if perm('be', 'bills_edit') || perm('ba', 'bills_archive') || perm('bd', 'bills_delete') || perm('bp', 'payments') || perm('rr', 'recycle');
      allow delete: if perm('rp', 'bills_delete');   // permanent delete / empty bin
    }

    /* ---------- products ---------- */
    match /products/{id} {
      allow read:   if isKnownUser();
      // catalogue builds itself while creating bills; sirf delete ki alag permission hai
      allow create: if perm('bc', 'bills_create') || perm('pd', 'products');
      allow update: if perm('bc', 'bills_create') || perm('pd', 'products');
      allow delete: if perm('pd', 'products');
    }

    /* ---------- activity log (append-only; never edited/deleted from client) ---------- */
    match /activity/{id} {
      allow read:   if isKnownUser();
      allow create: if isKnownUser();
      allow update, delete: if false;
    }

    /* ---------- stats aggregates (day + month) ---------- */
    match /stats/{day}    { allow read: if isKnownUser(); allow write: if perm('bc', 'bills_create') || perm('be', 'bills_edit') || perm('bd', 'bills_delete') || perm('ba', 'bills_archive') || perm('bp', 'payments') || perm('rr', 'recycle'); }
    match /stats_m/{month}{ allow read: if isKnownUser(); allow write: if perm('bc', 'bills_create') || perm('be', 'bills_edit') || perm('bd', 'bills_delete') || perm('ba', 'bills_archive') || perm('bp', 'payments') || perm('rr', 'recycle'); }
  }
}
