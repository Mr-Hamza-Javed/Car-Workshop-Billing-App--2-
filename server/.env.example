# ---------------------------------------------------------------------------
# MSA Billing API server — copy this file to `.env` and fill it in.
# ---------------------------------------------------------------------------

# Port the server listens on (most hosts set PORT for you).
PORT=8080

# Firebase project id.
FIREBASE_PROJECT_ID=mirza-bills

# Service-account credentials — use ONE of these three options:
#  1) path to the downloaded JSON key file
#     (Firebase console → Project settings → Service accounts → Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#  2) the whole JSON key pasted as one line (handy on Render / Railway / etc.)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"mirza-bills",...}
#  3) the JSON key base64-encoded
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoi...

# Timezone used for day/month report buckets. MUST match the shop's timezone
# (the browser used to compute these in local time).
TZ=Asia/Karachi

# Comma-separated list of web-app origins allowed to call the API (CORS).
# Leave empty or "*" to allow any origin (auth is still required on every data route).
ALLOWED_ORIGINS=https://mirza-bills.web.app,https://mirza-bills.firebaseapp.com

# Also serve the web app (index.html etc.) from this server, so ONE service hosts
# both the site and the API. Set to "false" if the site is hosted elsewhere.
SERVE_STATIC=true
